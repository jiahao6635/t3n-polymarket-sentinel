# Copy to .env.local and insert the one-time key from Terminal 3.
# Never commit or paste the real value into an issue, document, or chat.
T3N_API_KEY=
T3N_ENV=sandbox

# Only if the signed trust-manifest endpoint is unavailable, and only for
# sandbox/testnet. This deliberately disables TEE trust-anchor verification.
T3N_UNSAFE_TRUST_SERVER=0
